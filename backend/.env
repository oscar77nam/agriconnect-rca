# Configuration Base de Données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agriconnect_rca
DB_USER=agriconnect_user
DB_PASSWORD=Test2025

# Configuration JWT
JWT_SECRET=votre_jwt_secret_tres_long_et_securise_minimum_32_caracteres

# Configuration Serveur
PORT=3000
NODE_ENV=development

# Configuration CORS (optionnel)
ALLOWED_ORIGINS=http://localhost:19006,exp://192.168.1.100:19000

# Configuration Upload (futur)
MAX_FILE_SIZE=10mb
UPLOAD_PATH=./uploads

# Configuration Email (futur)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Configuration Sécurité
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Logs
LOG_LEVEL=info